# ============================================================================
# Supabase — Phase 3
#
# Copy this file to `.env.local` (git-ignored) and fill in the values from
# Supabase → Project Settings → API.
#
#   cp .env.example .env.local
#
# `.env.local` and `.env` are git-ignored. Never commit real values.
# ============================================================================

# --- Site --------------------------------------------------------------------

# The canonical origin used by <link rel="canonical">, openGraph, robots.txt and
# sitemap.xml. All four read this single value via `src/lib/site-url.ts`, so they
# can never disagree with each other.
#
# Leave this unset locally and on Vercel — it falls back to the Vercel
# production URL, then to http://localhost:3000. Set it explicitly only if you
# attach a custom domain, so SEO points at your real domain.
#
#   NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Public (safe to ship to the browser) -----------------------------------

# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon" / "publishable" API key. This key is protected by Row Level Security:
# anyone can hold it, but it can only do what the RLS policies allow.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server only (never exposed to the browser) -----------------------------

# "service_role" key. BYPASSES Row Level Security — treat it as a full database
# password.
#
# Only `src/lib/supabase/admin.ts` reads this, and that file imports
# `server-only`, so the build fails loudly if it ever reaches a client bundle.
# It is currently used by the contact-form intake route to run spam scoring
# before writing.
#
# Do not prefix this with NEXT_PUBLIC_. Doing so publishes it to every visitor.
SUPABASE_SERVICE_ROLE_KEY=
